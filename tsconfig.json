{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@lib/*": ["./lib/*"]
    }
  },
  "include": ["lib", "tools", "tests", "config", "private", "vitest.config.ts", "playwright.config.ts", "site/src/i18n", "site/src/render", "site/src/ecossistema", "site/src/home"],
  "exclude": ["node_modules", "dist", ".astro", ".agents"]
}
