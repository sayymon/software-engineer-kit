---
// SPDX-License-Identifier: MIT
// Ecossistema 3D: one graph with every entity of the kit. The 3D code loads only on this page, by dynamic import.
import '../../styles/ecossistema.css';
import Base from '../../layouts/Base.astro';
import { buildLocales, ctxFor } from '../../kit';
import { messages } from '../../i18n';
export function getStaticPaths() {
  return buildLocales().map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as 'pt-BR' | 'en';
const ctx = ctxFor(locale);
const t = ctx.t;
// The client reads the strings it needs from this JSON (no network call, works offline).
const textos = Object.fromEntries(Object.entries(messages[locale]).filter(([k]) => k.startsWith('eco.') || k.startsWith('tipo.')));
const home = `${ctx.base}/${locale}/`;
---
<Base locale={locale} title={t('eco.title')} slug="ecossistema" base={ctx.base} layer="ecossistema" tipo="ecossistema" description={t('eco.lede')} immersive>
  <div class="eco" data-island="ecossistema" data-base={ctx.base} data-locale={locale} data-pagefind-ignore>
    <div class="eco-stage" id="eco-stage" role="img" aria-label={t('eco.stageLabel')}></div>

    <header class="eco-hero">
      <p class="eco-eyebrow">{t('eco.eyebrow')}</p>
      <h1>{t('eco.title')}</h1>
      <p class="eco-lede">{t('eco.lede')}</p>
      <p class="eco-hint">{t('eco.hint')}</p>
    </header>

    <div class="eco-toolbar" role="group" aria-label={t('eco.layers')}>
      <div class="eco-search">
        <label class="sr-only" for="eco-q">{t('eco.search.label')}</label>
        <input id="eco-q" type="search" placeholder={t('eco.search.placeholder')} autocomplete="off" />
        <ul id="eco-results" class="eco-results" hidden></ul>
      </div>
      <button type="button" class="eco-btn eco-more" id="eco-more" aria-expanded="false" aria-controls="eco-controls">{t('eco.controls')}</button>
      <div class="eco-controls" id="eco-controls">
      <fieldset class="eco-layers">
        <legend class="sr-only">{t('eco.layers')}</legend>
        <label><input type="checkbox" data-camada="nucleo" checked /> {t('eco.layer.nucleo')}</label>
        <label><input type="checkbox" data-camada="fluxo" checked /> {t('eco.layer.fluxo')}</label>
        <label><input type="checkbox" id="eco-hubs" /> {t('eco.hubs')}</label>
      </fieldset>
      <label class="eco-select">{t('eco.depth')}
        <select id="eco-depth"><option value="1">1</option><option value="2">2</option></select>
      </label>
      <label class="eco-toggle"><input type="checkbox" id="eco-rotate" checked /> {t('eco.autoRotate')}</label>
      <button type="button" class="eco-btn" id="eco-recenter">{t('eco.recenter')}</button>
      <button type="button" class="eco-btn" id="eco-back" hidden>{t('eco.back')}</button>
      <button type="button" class="eco-btn" id="eco-exit" hidden>{t('eco.exit')}</button>
      </div>
    </div>

    <aside class="eco-legend" aria-label={t('eco.legend')}>
      <h2>{t('eco.legend')}</h2>
      <ul id="eco-legend-list"></ul>
      <p class="eco-status" id="eco-count" role="status"></p>
      <p class="eco-empty" id="eco-empty" hidden>{t('eco.none')} <button type="button" class="eco-btn" id="eco-clear">{t('eco.clear')}</button></p>
    </aside>

    <aside class="eco-panel" id="eco-panel" role="complementary" aria-labelledby="eco-panel-title" hidden>
      <button type="button" class="eco-close" id="eco-close" aria-label={t('eco.close')}>×</button>
      <div id="eco-panel-body"></div>
    </aside>

    <div class="eco-loading" id="eco-loading" role="status">
      <span class="eco-spinner" aria-hidden="true"></span>
      <span>{t('eco.loading')}</span>
    </div>
    <div class="eco-message" id="eco-fail" hidden>
      <p>{t('eco.loadFail')}</p>
      <button type="button" class="eco-btn" id="eco-retry">{t('eco.retry')}</button>
      <a class="eco-btn" href={`${home}tools/`}>{t('eco.fallbackLink')}</a>
    </div>
    <div class="eco-message" id="eco-nowebgl" hidden>
      <p>{t('eco.noWebgl')}</p>
      <a class="eco-btn eco-btn-primary" href={`${home}tools/`}>{t('eco.fallbackLink')}</a>
    </div>
    <p class="eco-notice" id="eco-notice" role="status" hidden></p>
    <div class="eco-tip" id="eco-tip" role="tooltip" hidden></div>
    <p class="sr-only" id="eco-live" aria-live="polite"></p>
    <noscript><div class="eco-message"><p>{t('eco.noscript')}</p><a class="eco-btn eco-btn-primary" href={`${home}tools/`}>{t('eco.fallbackLink')}</a></div></noscript>
    <script type="application/json" id="eco-i18n" set:html={JSON.stringify(textos)}></script>
  </div>
</Base>
<script>
  import '../../ecossistema/main';
</script>
