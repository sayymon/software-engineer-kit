---
// SPDX-License-Identifier: MIT
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/glass.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Diagram from '../components/Diagram.astro';
import { makeT } from '../i18n';
interface Props {
  locale: 'pt-BR' | 'en';
  title: string;
  slug: string;
  base: string;
  description?: string;
  layer?: string;
  tipo?: string;
  fallback?: boolean;
  hasDiagram?: boolean;
  searchPage?: boolean;
  immersive?: boolean;
}
const { locale, title, slug, base, description = '', layer = 'site', tipo = 'page', fallback = false, hasDiagram = false, immersive = false } = Astro.props;
const t = makeT(locale);
const site = t('site.title');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>try{document.documentElement.dataset.visual=localStorage.getItem('kit-visual')||'glass'}catch(e){document.documentElement.dataset.visual='glass'}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === site ? site : `${title} | ${site}`}</title>
    {description && <meta name="description" content={description.slice(0, 200)} />}
    <link rel="alternate" hreflang="pt-BR" href={`${base}/pt-BR/${slug ? `${slug}/` : ''}`} />
    <link rel="alternate" hreflang="en" href={`${base}/en/${slug ? `${slug}/` : ''}`} />
  </head>
  <body>
    {!immersive && <Header locale={locale} base={base} slug={slug} t={t} />}
    {immersive && <a class="skip-link" href="#eco-stage">{t('a11y.skip')}</a>}
    <main id="main" class={immersive ? 'immersive' : undefined} data-pagefind-body data-pagefind-filter="layer[data-layer]" data-fallback={fallback ? 'true' : 'false'} data-layer={layer} data-tipo={tipo}>
      {fallback && <p class="banner" role="note" data-pagefind-ignore>{t('fallback.banner')}</p>}
      <slot />
    </main>
    {!immersive && <Footer locale={locale} base={base} t={t} />}
    {hasDiagram && <Diagram base={base} />}
    <script is:inline>
      (function () {
        var raf = 0, alvo = null, x = 0, y = 0;
        var seletor = '.site-header, .cards li, .glass-btn';
        document.addEventListener('pointermove', function (e) {
          var el = e.target.closest && e.target.closest(seletor);
          if (!el) return;
          alvo = el; x = e.clientX; y = e.clientY;
          if (raf) return;
          raf = requestAnimationFrame(function () {
            raf = 0;
            var r = alvo.getBoundingClientRect();
            alvo.style.setProperty('--mx', x - r.left + 'px');
            alvo.style.setProperty('--my', y - r.top + 'px');
          });
        }, { passive: true });
      })();
    </script>
  </body>
</html>
