{
  "name": "software-engineer-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Kit de engenharia de software e IA: ferramentas, fundamentos, stacks, guias praticos, jornadas e certificacoes.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "tsx tools/validate/index.ts",
