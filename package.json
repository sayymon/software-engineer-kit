    "preview": "astro preview --root site",
    "smoke": "tsx tools/preview/smoke.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "astro": "^5.18.2",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.6.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
