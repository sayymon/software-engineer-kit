{
  "name": "software-engineer-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Kit de engenharia de software e IA: ferramentas, fundamentos, stacks, guias praticos, jornadas e certificacoes.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "validate": "tsx tools/validate/index.ts",
    "test": "vitest run",
    "schema:gen": "tsx tools/schema/generate.ts",
    "migrate": "tsx tools/private/run.ts tools/migrate/index.ts",
    "linkback": "tsx tools/private/run.ts tools/linkback/linkback.ts",
    "build": "tsx tools/site/build.ts",
    "build:pt-BR": "tsx tools/site/build.ts pt-BR",
    "build:en": "tsx tools/site/build.ts en",
    "preview": "astro preview --root site",
    "guide": "tsx tools/guide/cli.ts",
    "smoke": "tsx tools/preview/smoke.ts",
    "test:browser": "playwright test",
    "agents:sync": "tsx tools/agents/sync.ts",
    "skills:update": "npx skills update --project --yes",
    "skills:restore": "npx skills experimental_install --frozen-lockfile --agent claude-code kiro-cli opencode"
  },
  "dependencies": {
    "3d-force-graph": "1.80.2",
    "ajv": "^8.20.0",
    "astro": "^7.4.13",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.6.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "three": "0.187.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "d3-force-3d": "3.0.6",
    "fast-check": "4.11.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
