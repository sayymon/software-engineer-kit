{
  "title": "benchmark",
  "x-translatable": [
    "nome",
    "descricao",
    "body",
    "avalia",
    "metodo",
    "metrica",
    "escala",
    "limitacoes",
    "contaminacao"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "descricao": {
      "type": "string"
    },
    "publico": {
      "default": false,
      "type": "boolean"
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "livro",
              "artigo",
              "curso"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "string",
            "minLength": 1
          },
          "status_revisao": {
            "type": "string",
            "enum": [
              "pendente",
              "em_revisao",
              "revisada"
            ]
          },
          "proxima_revisao": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "tipo",
          "titulo",
          "link",
          "status_revisao",
          "proxima_revisao"
        ],
        "additionalProperties": false
      }
    },
    "fonte_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataVerificacao": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "guia_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      }
    },
    "tipo": {
      "type": "string",
      "const": "benchmark"
    },
    "area": {
      "type": "string"
    },
    "avalia": {
      "type": "string"
    },
    "metodo": {
      "type": "string"
    },
    "metrica": {
      "type": "string"
    },
    "escala": {
      "type": "string"
    },
    "limitacoes": {
      "type": "string"
    },
    "saturacao": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "não verificado"
      ]
    },
    "contaminacao": {
      "type": "string"
    },
    "mantenedor": {
      "type": "string"
    },
    "urlOficial": {
      "type": "string"
    },
    "funcionalidadesMedidas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "casosDeUsoRelacionados": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "modelosAvaliados": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "resultados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modelo": {
            "type": "string",
            "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
          },
          "valor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "const": "não verificado"
              }
            ]
          },
          "unidade": {
            "type": "string"
          },
          "origem": {
            "type": "string",
            "enum": [
              "autodeclarado-fornecedor",
              "tabela-oficial-benchmark",
              "leaderboard-oficial",
              "artigo",
              "terceiro-independente",
              "não verificado"
            ]
          },
          "fonte": {
            "type": "string"
          },
          "data": {
            "type": "string"
          },
          "nota": {
            "type": "string"
          }
        },
        "required": [
          "modelo",
          "valor",
          "origem",
          "fonte",
          "data"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "nome",
    "tipo",
    "area"
  ],
  "additionalProperties": false
}
