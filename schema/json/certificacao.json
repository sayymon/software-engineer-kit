{
  "title": "certificacao",
  "x-translatable": [
    "nome",
    "descricao",
    "body",
    "formato",
    "validade",
    "renovacao",
    "preRequisitos",
    "oQueComprova",
    "paraQuem",
    "observacoes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "descricao": {
      "type": "string"
    },
    "publico": {
      "default": false,
      "type": "boolean"
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "livro",
              "artigo",
              "curso"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "string",
            "minLength": 1
          },
          "status_revisao": {
            "type": "string",
            "enum": [
              "pendente",
              "em_revisao",
              "revisada"
            ]
          },
          "proxima_revisao": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "tipo",
          "titulo",
          "link",
          "status_revisao",
          "proxima_revisao"
        ],
        "additionalProperties": false
      }
    },
    "fonte_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataVerificacao": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "guia_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      }
    },
    "tipo": {
      "type": "string",
      "const": "certificacao"
    },
    "emissor": {
      "type": "string"
    },
    "emissorEmpresa": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "enum": [
        "tecnica",
        "soft-skill",
        "ia"
      ]
    },
    "nivel": {
      "type": "string",
      "enum": [
        "fundamental",
        "associado",
        "profissional",
        "especialista"
      ]
    },
    "formato": {
      "type": "string"
    },
    "custoUSD": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "const": "não verificado"
        }
      ]
    },
    "validade": {
      "type": "string"
    },
    "renovacao": {
      "type": "string"
    },
    "preRequisitos": {
      "type": "string"
    },
    "oQueComprova": {
      "type": "string"
    },
    "paraQuem": {
      "type": "string"
    },
    "urlOficial": {
      "type": "string",
      "pattern": "^https:\\/\\/\\S+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "descontinuada",
        "em transição"
      ]
    },
    "observacoes": {
      "type": "string"
    },
    "ferramentasRelacionadas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "categoriasRelacionadas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "habilidadesRelacionadas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    }
  },
  "required": [
    "id",
    "nome",
    "tipo",
    "emissor",
    "area",
    "nivel",
    "urlOficial",
    "status"
  ],
  "additionalProperties": false
}
