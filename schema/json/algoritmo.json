{
  "title": "algoritmo",
  "x-translatable": [
    "nome",
    "descricao",
    "body",
    "exemplo",
    "quando_usar",
    "quando_evitar",
    "subarea",
    "categoria",
    "entrada",
    "saida",
    "preCondicoes",
    "limitacoes",
    "casosDeUso"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "descricao": {
      "type": "string"
    },
    "publico": {
      "default": false,
      "type": "boolean"
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "livro",
              "artigo",
              "curso"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "string",
            "minLength": 1
          },
          "status_revisao": {
            "type": "string",
            "enum": [
              "pendente",
              "em_revisao",
              "revisada"
            ]
          },
          "proxima_revisao": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "tipo",
          "titulo",
          "link",
          "status_revisao",
          "proxima_revisao"
        ],
        "additionalProperties": false
      }
    },
    "fonte_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataVerificacao": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "guia_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      }
    },
    "exemplo": {
      "type": "string"
    },
    "quando_usar": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quando_evitar": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "default": "rascunho",
      "type": "string",
      "enum": [
        "rascunho",
        "revisado",
        "publicado"
      ]
    },
    "tipo": {
      "type": "string",
      "const": "algoritmo"
    },
    "area": {
      "type": "string",
      "enum": [
        "ordenacao",
        "busca",
        "grafos",
        "programacao-dinamica",
        "guloso",
        "divisao-e-conquista",
        "backtracking",
        "strings"
      ]
    },
    "subarea": {
      "type": "string"
    },
    "categoria": {
      "type": "string"
    },
    "entrada": {
      "type": "string"
    },
    "saida": {
      "type": "string"
    },
    "complexidade": {
      "type": "object",
      "properties": {
        "tempoMelhor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^O\\(.+\\)$"
            },
            {
              "type": "string",
              "const": "não se aplica"
            }
          ]
        },
        "tempoMedio": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^O\\(.+\\)$"
            },
            {
              "type": "string",
              "const": "não se aplica"
            }
          ]
        },
        "tempoPior": {
          "type": "string",
          "pattern": "^O\\(.+\\)$"
        },
        "memoria": {
          "type": "string"
        },
        "observacao": {
          "type": "string"
        }
      },
      "required": [
        "tempoMelhor",
        "tempoMedio",
        "tempoPior",
        "memoria"
      ],
      "additionalProperties": false
    },
    "preCondicoes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitacoes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "casosDeUso": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "casosDeUsoKit": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "estruturasDeDados": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "algoritmosRelacionados": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "padroes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "ferramentas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(\\[\\[[^\\[\\]\\n]+\\]\\]|tabela:[a-z0-9_-]+)$"
      }
    },
    "implementacao": {
      "type": "object",
      "properties": {
        "linguagemReferencia": {
          "type": "string"
        },
        "versao": {
          "type": "string"
        },
        "bibliotecaPadrao": {
          "type": "string"
        },
        "casosDeBorda": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "linguagemReferencia",
        "versao"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "nome",
    "tipo",
    "area",
    "entrada",
    "saida",
    "complexidade",
    "preCondicoes",
    "limitacoes",
    "casosDeUso"
  ],
  "additionalProperties": false
}
