{
  "title": "modelo",
  "x-translatable": [
    "nome",
    "descricao",
    "body"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "descricao": {
      "type": "string"
    },
    "publico": {
      "default": false,
      "type": "boolean"
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "livro",
              "artigo",
              "curso"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "string",
            "minLength": 1
          },
          "status_revisao": {
            "type": "string",
            "enum": [
              "pendente",
              "em_revisao",
              "revisada"
            ]
          },
          "proxima_revisao": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "tipo",
          "titulo",
          "link",
          "status_revisao",
          "proxima_revisao"
        ],
        "additionalProperties": false
      }
    },
    "fonte_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataVerificacao": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "guia_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      }
    },
    "tipo": {
      "type": "string",
      "const": "modelo"
    },
    "familia": {
      "type": "string"
    },
    "empresa": {
      "type": "string",
      "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
    },
    "lancamento": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "legado",
        "preview",
        "descontinuado"
      ]
    },
    "idModeloApi": {
      "type": "string"
    },
    "contextoTokens": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "const": "não verificado"
        }
      ]
    },
    "saidaMaxTokens": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "const": "não verificado"
        }
      ]
    },
    "modalidadesEntrada": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modalidadesSaida": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "precoEntradaUSD": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "const": "não verificado"
        }
      ]
    },
    "precoSaidaUSD": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "const": "não verificado"
        }
      ]
    },
    "precoCacheUSD": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "const": "não verificado"
        }
      ]
    },
    "licenca": {
      "type": "string"
    },
    "disponibilidade": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "api",
          "assinatura",
          "pesos-abertos"
        ]
      }
    },
    "ferramentas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "funcionalidades": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "casosDeUso": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "fontePreco": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "nome",
    "tipo"
  ],
  "additionalProperties": false
}
