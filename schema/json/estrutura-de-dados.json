{
  "title": "estrutura-de-dados",
  "x-translatable": [
    "nome",
    "descricao",
    "body",
    "exemplo",
    "quando_usar",
    "quando_evitar",
    "propriedades",
    "tradeoffs",
    "casosDeBorda",
    "casosDeUso"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "descricao": {
      "type": "string"
    },
    "publico": {
      "default": false,
      "type": "boolean"
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "livro",
              "artigo",
              "curso"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "string",
            "minLength": 1
          },
          "status_revisao": {
            "type": "string",
            "enum": [
              "pendente",
              "em_revisao",
              "revisada"
            ]
          },
          "proxima_revisao": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "tipo",
          "titulo",
          "link",
          "status_revisao",
          "proxima_revisao"
        ],
        "additionalProperties": false
      }
    },
    "fonte_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataVerificacao": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "guia_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      }
    },
    "exemplo": {
      "type": "string"
    },
    "quando_usar": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quando_evitar": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "default": "rascunho",
      "type": "string",
      "enum": [
        "rascunho",
        "revisado",
        "publicado"
      ]
    },
    "tipo": {
      "type": "string",
      "const": "estrutura-de-dados"
    },
    "familia": {
      "type": "string",
      "enum": [
        "linear",
        "associativa",
        "arvore",
        "grafo",
        "especializada"
      ]
    },
    "operacoes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "melhor": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^O\\(.+\\)$"
              },
              {
                "type": "string",
                "const": "não se aplica"
              }
            ]
          },
          "medio": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^O\\(.+\\)$"
              },
              {
                "type": "string",
                "const": "não se aplica"
              }
            ]
          },
          "pior": {
            "type": "string",
            "pattern": "^O\\(.+\\)$"
          },
          "observacao": {
            "type": "string"
          }
        },
        "required": [
          "nome",
          "melhor",
          "medio",
          "pior"
        ],
        "additionalProperties": false
      }
    },
    "memoria": {
      "type": "string",
      "pattern": "^O\\(.+\\)$"
    },
    "propriedades": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tradeoffs": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^Ganha: .+; paga: .+"
      }
    },
    "casosDeBorda": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "casosDeUso": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "estruturasRelacionadas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "algoritmosRelacionados": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "padroes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "ferramentas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(\\[\\[[^\\[\\]\\n]+\\]\\]|tabela:[a-z0-9_-]+)$"
      }
    },
    "implementacao": {
      "type": "object",
      "properties": {
        "linguagemReferencia": {
          "type": "string"
        },
        "versao": {
          "type": "string"
        },
        "bibliotecaPadrao": {
          "type": "string"
        },
        "casosDeBorda": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "linguagemReferencia",
        "versao"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "nome",
    "tipo",
    "familia",
    "operacoes",
    "memoria",
    "tradeoffs",
    "casosDeBorda"
  ],
  "additionalProperties": false
}
