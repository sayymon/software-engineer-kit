{
  "title": "ferramenta",
  "x-translatable": [
    "nome",
    "descricao",
    "body",
    "restricoes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "descricao": {
      "type": "string"
    },
    "publico": {
      "default": false,
      "type": "boolean"
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "livro",
              "artigo",
              "curso"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "string",
            "minLength": 1
          },
          "status_revisao": {
            "type": "string",
            "enum": [
              "pendente",
              "em_revisao",
              "revisada"
            ]
          },
          "proxima_revisao": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "tipo",
          "titulo",
          "link",
          "status_revisao",
          "proxima_revisao"
        ],
        "additionalProperties": false
      }
    },
    "fonte_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataVerificacao": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "guia_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      }
    },
    "tipo": {
      "type": "string",
      "const": "ferramenta"
    },
    "tipos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "empresa": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "funcionalidades": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "casosDeUso": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "modelos": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\[\\]\\n]+\\]\\]$"
      }
    },
    "modeloContratacao": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "precoUSD": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "const": "não verificado"
        }
      ]
    },
    "precoMedio": {
      "type": "number"
    },
    "plataformas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linguagens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "porte": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "segmentos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restricoes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fontePreco": {
      "type": "string"
    },
    "licenca": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "nome",
    "tipo"
  ],
  "additionalProperties": false
}
